{
  "schemaVersion": 1,
  "id": "e4steam_public_servers",
  "version": "${version}",
  "name": "e4steam Public Servers",
  "description": "A privacy-safe catalog of public e4steam worlds and dedicated servers.",
  "authors": ["K2 Studio Development"],
  "contact": {
    "homepage": "https://github.com/K2-Studio-Development",
    "sources": "https://github.com/K2-Studio-Development/e4steam-Public-Servers",
    "issues": "https://github.com/K2-Studio-Development/e4steam-Public-Servers/issues"
  },
  "license": "Apache-2.0",
  "environment": "*",
  "entrypoints": {
    "client": [
      "dev.k2studio.e4steam.publicservers.fabric.FabricPublicServersClient"
    ],
    "e4steam": [
      "dev.k2studio.e4steam.publicservers.common.PublicServersAddon"
    ]
  },
  "mixins": [
    {
      "config": "e4steam_public_servers.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.5",
    "minecraft": ">=26.1- <26.3-",
    "java": ">=25",
    "e4steam": ">=0.3.2-beta.1"
  }
}
